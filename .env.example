# Copy this file to .env and fill in your own values. Never commit .env.

# Server
PORT=3000

# PayMongo TEST keys (Dashboard -> Developers -> API Keys)
PAYMONGO_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
PAYMONGO_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxx
# Signing secret of your webhook endpoint (starts with whsk_). Optional until you add the webhook.
PAYMONGO_WEBHOOK_SECRET=whsk_xxxxxxxxxxxxxxxx

# Firebase Admin: use ONE of these
# 1) Local: path to the service account file
GOOGLE_APPLICATION_CREDENTIALS=./server/service-account.json
# 2) On a host such as Render: paste the whole service account JSON on one line
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}

# Extra website addresses allowed to call this server, separated by commas (optional)
# ALLOWED_ORIGINS=http://localhost:5000

# Order status emails sent by the server (EmailJS). Optional: without these, only the browser/app sends emails.
# EMAILJS_SERVICE_ID=service_xxxxxxx
# EMAILJS_ORDER_TEMPLATE_ID=template_xxxxxxx
# EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxx
# EMAILJS_PRIVATE_KEY=xxxxxxxxxxxxxxx
