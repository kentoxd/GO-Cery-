# Server
PORT=3000

# PayMongo (sandbox) — paste your keys into .env locally; never commit .env
PAYMONGO_SECRET_KEY=sk_test_xxxxxxxx
PAYMONGO_PUBLIC_KEY=pk_test_xxxxxxxx
PAYMONGO_WEBHOOK_SECRET=whsk_test_xxxxxxxx

# Firebase Admin SDK — download service account JSON from Firebase Console
# Project Settings → Service accounts → Generate new private key
GOOGLE_APPLICATION_CREDENTIALS=./server/service-account.json
