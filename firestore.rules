rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function orderRef(orderId) {
      return /databases/$(database)/documents/orders/$(orderId);
    }

    match /products/{id} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() ||
        (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['variants']));
    }

    match /reviews/{id} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.orderId is string
        && get(orderRef(request.resource.data.orderId)).data.userId == request.auth.uid
        && get(orderRef(request.resource.data.orderId)).data.status == 'Delivered'
        && request.resource.data.productId in get(orderRef(request.resource.data.orderId)).data.productIds;
      allow update, delete: if isAdmin();
    }

    match /cms/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /meta/{id} {
      allow read: if true;
      allow write: if false; // set once via Admin SDK seed script only
    }

    match /admins/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid; // check "am I an admin"
      allow list: if isAdmin(); // only admins can list all admins (role management view)
      allow write: if isAdmin(); // first admin must be seeded server-side
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isAdmin() ||
        (isOwner(userId) && !('role' in request.resource.data.diff(resource.data).affectedKeys()));
    }

    match /carts/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /orders/{orderId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'Pending'
        && request.resource.data.inventoryDeducted == false
        && request.resource.data.paymentStatus in ['pending_collection', 'awaiting_manual_verification']
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.total is number
        && request.resource.data.total >= 0;
      allow update: if isAdmin()
        || (isSignedIn()
            && resource.data.userId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['receiptUrl', 'receiptUploadedAt']))
        // customers may cancel their own order while it is still Pending
        || (isSignedIn()
            && resource.data.userId == request.auth.uid
            && resource.data.status == 'Pending'
            && request.resource.data.status == 'Cancelled'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'statusHistory']));
      allow delete: if isAdmin();
    }

    match /loyalty/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin() ||
        (isOwner(userId) && request.resource.data.keys().hasOnly(['points', 'tier', 'referrals']));
    }

    match /wishlists/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /auditLogs/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
